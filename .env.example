# Required in production
GEMINI_API_KEY=""
MONGODB_CONNECTION_STRING=""
EMBEDDING_MODEL_URL=""
RESEND_API_KEY=""

# Optional: Gemini Live route override
# GEMINI_LIVE_MODEL="gemini-live-2.5-flash-preview"

# Optional: MongoDB naming overrides
# MONGODB_COURSES_DB="VectorDB"
# MONGODB_COURSES_COLLECTION="courses"
# MONGODB_PROFESSORS_COLLECTION="professors"

# Optional: NextAuth and OAuth providers
# NEXTAUTH_SECRET=""
# MONGODB_AUTH_DB_NAME=""
# MONGODB_AUTH_USERS_COLLECTION="auth_users"
# MONGODB_DB_NAME=""
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# AZURE_AD_CLIENT_ID=""
# AZURE_AD_CLIENT_SECRET=""
# AZURE_AD_TENANT_ID=""
# FACEBOOK_CLIENT_ID=""
# FACEBOOK_CLIENT_SECRET=""

# Optional: transcript parser tuning
# TRANSCRIPT_PARSE_TIMEOUT_MS="25000"
# MAX_DEGREE_PROGRESS_PDF_BYTES="8388608"
# TRANSCRIPT_MAX_RAW_CHARS="120000"
# TRANSCRIPT_MAX_JSON_MODEL_CHARS="70000"
# TRANSCRIPT_MODEL_ENRICHMENT="true"
# TRANSCRIPT_PARSER_STRATEGY="ai-first"
